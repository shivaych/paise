# Copy to .env and fill in. Everything here is optional — with none of it set,
# the whole project still runs on MockRail with the deterministic planner.

# ---------------------------------------------------------------------------
# Planner model (free tier is plenty — the planner runs once per plan)
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Run `npm run check:gemini` to see what your key can reach.
GEMINI_MODEL=gemini-2.0-flash

# Alternative, used only if GEMINI_API_KEY is unset
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Razorpay — standard API key (instant, free, self-serve, test mode)
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set when you create the webhook in the dashboard. Enables POST /webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# RazorpayX — SEPARATE product, separate access. Payouts do not work without it.
# Leave blank to keep using MockRail for settlement.
# ---------------------------------------------------------------------------
RAZORPAYX_ACCOUNT_NUMBER=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PAISE_SIGNING_SECRET=paise-dev-signing-key-change-me
PAISE_DASHBOARD_PORT=4020
PAISE_PROVIDERS_PORT=4021
